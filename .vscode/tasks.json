{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "server: build",
      "type": "process",
      "command": "${env:HOME}/.dotnet/dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Server.AspNetCore/src/MoyKabinet.Api/MoyKabinet.Api.csproj",
        "--configuration",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "server: run",
      "type": "process",
      "command": "${workspaceFolder}/Server.AspNetCore/run-server.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "server: test",
      "type": "process",
      "command": "${env:HOME}/.dotnet/dotnet",
      "args": [
        "test",
        "${workspaceFolder}/Server.AspNetCore/MoyKabinet.Server.slnx",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
